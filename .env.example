# One application manages all adventures in this folder.
# Existing single-game folders must be imported, never reused as an app root.
DATA_PATH=./pokesim-app
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8930
PUBLIC_URL=http://localhost:8930

# Build the current checkout with compose.build.yaml before starting.
POKESIM_IMAGE=pokesim:local
