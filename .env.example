# Copy to .env before starting. These are host paths.
ROM_FILE=./roms/pokered.gb
DATA_PATH=./data
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8930
PUBLIC_URL=http://localhost:8930

# Local source build. Set an exact downloaded tag when using a release archive.
POKESIM_IMAGE=pokesim:local
SPEED=1
POLICY=strategic
STARTER=random

# Server-enforced viewing without game controls.
VIEWER_ONLY=0

# Optional shared automatic trader. Set the instance to red or blue for this game.
TRADING_URL=
TRADING_INSTANCE=

# Optional notifications. Leave empty to disable outbound notifications.
NTFY_URL=
NTFY_TOKEN=
NTFY_MIN_PRIORITY=2
NTFY_MUTE=

# Event retention is opt-in. Zero keeps all event history and attachments.
EVENT_RETENTION_DAYS=0
AUTOSAVE_SECONDS=60
KEEP_AUTOSAVES=20
