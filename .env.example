# One application manages all adventures in this folder.
# Existing single-game folders must be imported, never reused as an app root.
DATA_PATH=./pokesim-app
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8930
PUBLIC_URL=http://localhost:8930

# Use a published version from GHCR. The release download pins its own version.
# Source builds use compose.build.yaml when both building and starting.
POKESIM_IMAGE=ghcr.io/afk-sapien/pokesim:0.3.7
