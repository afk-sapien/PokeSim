# Optional overrides for the original bind-mount compose.yaml.
# For compose.quickstart.yaml, omit DATA_PATH to keep its Docker-managed volume.
# Copy only the settings you need into .env.
# One application manages all adventures in this folder.
# Existing single-game folders must be imported, never reused as an app root.
DATA_PATH=./pokesim-app
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8930
# PUBLIC_URL defaults to http://localhost:${HTTP_PORT} in the current Compose files.
# Set it explicitly when accessing the app through a server address or proxy.
# PUBLIC_URL=http://localhost:8930

# Use a published version from GHCR. The release download pins its own version.
# Source builds use compose.build.yaml when both building and starting.
POKESIM_IMAGE=ghcr.io/afk-sapien/pokesim:0.5.0
